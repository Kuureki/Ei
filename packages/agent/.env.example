# --- model ---
# Either the AI Gateway key (routes string model ids) ...
AI_GATEWAY_API_KEY=
# ... or a direct provider key for the model in agent/agent.ts:
ANTHROPIC_API_KEY=

# --- innernet (memory MCP connection) ---
INNERNET_KEY=

# --- transcription (whisper) ---
OPENAI_API_KEY=

# --- discord (custom channel + connector) ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
AGENT_OWNER_DISCORD_ID=
EVE_CONNECTOR_SECRET=

# --- runtime ---
PORT=3000
EVE_RUNTIME_URL=http://127.0.0.1:3000
EVE_INTAKE_PATH=/intake

# --- postgres world (production; @workflow/world-postgres) ---
# Select the durable Postgres world (the default is the zero-DB local world).
# Set both in production; leave WORKFLOW_TARGET_WORLD unset for `eve dev`.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# Connection string for durable session/workflow state.
WORKFLOW_POSTGRES_URL=
# Optional queue-name prefix and worker tuning.
WORKFLOW_POSTGRES_JOB_PREFIX=ei
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
